{
    "format_version": "1.26.3",
    "minecraft:block": {
        "description": {
            "identifier": "td:whisperwood",
            "menu_category": {
                "category": "nature"
            },
            "states": {
                "td:log_axis":[0,1,2]
            }
        },
        "permutations": [
            {
                "condition": "q.block_state('td:log_axis')== 0",
                "components": {
                    "minecraft:transformation": { "rotation": [0, 0, 0] }
                  }
            },
            {
                "condition": "q.block_state('td:log_axis')== 1",
                "components": {
                    "minecraft:transformation": { "rotation": [90, 0, 0] }
                  }
            },
            {
                "condition": "q.block_state('td:log_axis')== 2",
                "components": {
                    "minecraft:transformation": { "rotation": [0, 0, 90] }
                  }
            }
        ],
        "components": {
            "minecraft:collision_box": {
				"origin": [-8,0,-8],
				"size": [16,16,16]
			},
			"minecraft:selection_box": {
				"origin": [-8,0,-8],
				"size": [16,16,16]
			},
            "minecraft:destructible_by_explosion" : true,
            "minecraft:display_name": "Whisperwood",
            "minecraft:material_instances": {
                "*": {
                    "texture": "whisperwood"      
                },
                "up":{
                    "texture": "whisperwood_top"      
                },
                "down":{
                    "texture": "whisperwood_top"
                }
            },
            "minecraft:geometry":{
                "identifier": "geometry.unit_cube"
            }
        }
    }
}