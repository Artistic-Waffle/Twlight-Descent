{
  "format_version": "1.26.30",
  "minecraft:tree_feature": {
    "description": {
      "identifier": "td:scorched_banneroak_bare_feature"
    },

    "acacia_trunk": {
      "trunk_width": 1,

      "trunk_height": {
        "base": 3,
        "intervals": [
          4
        ],
        "min_height_for_canopy": 3
      },

      "trunk_block": {
        "name": "td:banneroak_log"
      },

      "trunk_lean": {
            "allow_diagonal_growth": false,

            "lean_height": {
                "range_min": 2,
                "range_max": 3
            },

            "lean_steps": {
                "range_min": 1,
                "range_max": 1
            },

            "lean_length": {
                "range_min": 1,
                "range_max": 1
            }
        }
    },

    "may_grow_on": [
      "td:ashbanner_grass_block",
      "td:war_torn_soil",
      "td:ash",
      "td:scorched_gravel"
    ],

    "may_replace": [
      "minecraft:air",
      "td:battlefield_grass",
      "td:ashroot",
      "td:ironweed",
      "td:trench_thistle",
      "td:thorn_bush"
    ],

    "may_grow_through": [
      "minecraft:air",
      "td:battlefield_grass",
      "td:ashroot",
      "td:ironweed",
      "td:trench_thistle",
      "td:thorn_bush"
    ]
  }
}